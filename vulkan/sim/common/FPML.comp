void boundary_light_deposit_wall_quad_vertices(
    LightingSurfaceObjectMetadata surfaceObject,
    uint vertex00,
    uint vertex10,
    uint vertex11,
    uint vertex01,
    vec2 hitUV,
    vec2 uv00,
    vec2 uv10,
    vec2 uv11,
    vec2 uv01,
    float radius,
    vec3 rgb)
{
    float invRadius = 1.0 / max(radius, EPSILON);
    float w00 = max(0.0, 1.0 - length(hitUV - uv00) * invRadius);
    float w10 = max(0.0, 1.0 - length(hitUV - uv10) * invRadius);
    float w11 = max(0.0, 1.0 - length(hitUV - uv11) * invRadius);
    float w01 = max(0.0, 1.0 - length(hitUV - uv01) * invRadius);

    if (w00 > 0.0)
    {
        boundary_light_write_surface_vertex(surfaceObject, vertex00, rgb * w00);
    }
    if (w10 > 0.0)
    {
        boundary_light_write_surface_vertex(surfaceObject, vertex10, rgb * w10);
    }
    if (w11 > 0.0)
    {
        boundary_light_write_surface_vertex(surfaceObject, vertex11, rgb * w11);
    }
    if (w01 > 0.0)
    {
        boundary_light_write_surface_vertex(surfaceObject, vertex01, rgb * w01);
    }
}

void DepositLightingSurfaceWallVertexSplat(
    RectangleWallSegment wall,
    vec3 point,
    vec3 rgb)
{
#if !FPML_ENABLE_SURFACE_DEPOSIT || !FPML_ENABLE_WALL_DEPOSIT
    return;
#endif
    LightingSurfaceWallMetadata surfaceWall =
        boundary_light_surface_wall_metadata(wall.wallFlag);
    LightingSurfaceObjectMetadata surfaceObject =
        boundary_light_surface_object_metadata(
            BOUNDARY_LIGHT_SURFACE_RECTANGLE_WALL,
            wall.wallFlag);
    if (surfaceObject.vertexOffset == npos || surfaceObject.vertexCount == 0u)
    {
        return;
    }

    float uCoord = 0.0;
    float vCoord = 0.0;
    float signedInwardDistance = 0.0;
    if (!RectangleWallProjectPoint(
            wall,
            point,
            uCoord,
            vCoord,
            signedInwardDistance))
    {
        vec3 rel = point - wall.origin;
        uCoord = clamp(dot(rel, wall.uAxis), 0.0, wall.uLength);
        vCoord = clamp(dot(rel, wall.vAxis), 0.0, wall.vLength);
    }
    vec3 hitPoint = wall.origin + wall.uAxis * uCoord + wall.vAxis * vCoord;

    uint uStepCount = max(1u, surfaceWall.uStepCount);
    uint vStepCount = max(1u, surfaceWall.vStepCount);
    float uStep = surfaceWall.uLength / float(uStepCount);
    float vStep = surfaceWall.vLength / float(vStepCount);
    float fu = clamp(
        uCoord / max(surfaceWall.uLength, EPSILON) * float(uStepCount),
        0.0,
        float(uStepCount));
    float fv = clamp(
        vCoord / max(surfaceWall.vLength, EPSILON) * float(vStepCount),
        0.0,
        float(vStepCount));

    uint uQuad = min(uint(floor(fu)), uStepCount - 1u);
    uint vQuad = min(uint(floor(fv)), vStepCount - 1u);
    int uCenter = int(uQuad);
    int vCenter = int(vQuad);
    vec2 hitUV = vec2(uCoord, vCoord);
    float automaticSplatRadius = max(max(uStep, vStep) * 1.5, EPSILON);
    float splatRadius = surfaceObject.depositRadius > EPSILON
        ? surfaceObject.depositRadius
        : automaticSplatRadius;
    int uSplatCells = int(clamp(ceil(splatRadius / max(uStep, EPSILON)), 1.0, 8.0));
    int vSplatCells = int(clamp(ceil(splatRadius / max(vStep, EPSILON)), 1.0, 8.0));

    for (int du = -uSplatCells; du <= uSplatCells; ++du)
    {
        int uIndex = uCenter + du;
        if (uIndex < 0 || uIndex >= int(uStepCount))
        {
            continue;
        }

        for (int dv = -vSplatCells; dv <= vSplatCells; ++dv)
        {
            int vIndex = vCenter + dv;
            if (vIndex < 0 || vIndex >= int(vStepCount))
            {
                continue;
            }

            uint rowStride = vStepCount + 1u;
            uint vertex00 = surfaceObject.vertexOffset
                + uint(uIndex) * rowStride + uint(vIndex);
            uint vertex10 = surfaceObject.vertexOffset
                + uint(uIndex + 1) * rowStride + uint(vIndex);
            uint vertex11 = surfaceObject.vertexOffset
                + uint(uIndex + 1) * rowStride + uint(vIndex + 1);
            uint vertex01 = surfaceObject.vertexOffset
                + uint(uIndex) * rowStride + uint(vIndex + 1);
            float u0 = float(uIndex) * uStep;
            float u1 = float(uIndex + 1) * uStep;
            float v0 = float(vIndex) * vStep;
            float v1 = float(vIndex + 1) * vStep;
            vec3 quadCenter =
                wall.origin +
                wall.uAxis * ((u0 + u1) * 0.5) +
                wall.vAxis * ((v0 + v1) * 0.5);
            float quadWeight = max(
                0.0,
                1.0 - length(hitPoint - quadCenter) / max(splatRadius, EPSILON));

            boundary_light_deposit_wall_quad_vertices(
                surfaceObject,
                vertex00,
                vertex10,
                vertex11,
                vertex01,
                hitUV,
                vec2(u0, v0),
                vec2(u1, v0),
                vec2(u1, v1),
                vec2(u0, v1),
                splatRadius,
                rgb * quadWeight);
        }
    }
}
