void boundary_light_write_surface_vertex(
    LightingSurfaceObjectMetadata surfaceObject,
    uint vertexID,
    vec3 rgb)
{
    if (vertexID == npos ||
        vertexID < surfaceObject.vertexOffset ||
        vertexID >= surfaceObject.vertexOffset + surfaceObject.vertexCount)
    {
        return;
    }
    vec3 clampedRgb = clamp(rgb, vec3(0.0), vec3(1.0));
    if (max(max(clampedRgb.r, clampedRgb.g), clampedRgb.b) <= 0.0)
    {
        return;
    }
    vec4 currentLight = LightingSurface[vertexID].light;
    uint illuminationMode =
        boundary_light_material_contact_illumination(surfaceObject.materialID);

    vec4 initialLight = surfaceObject.initialSurfaceColor;
    bool stillAtInitialColor =
        length(currentLight.rgb - initialLight.rgb) <= 0.0001 &&
        abs(currentLight.w - initialLight.w) <= 0.0001;

    if (illuminationMode == CONTACT_ILLUMINATION_FIRST &&
        currentLight.w > 0.5 &&
        !stillAtInitialColor)
    {
        return;
    }

    if (illuminationMode == CONTACT_ILLUMINATION_MAX &&
        currentLight.w > 0.5 &&
        boundary_light_rgb_luminance(clampedRgb) <
            boundary_light_rgb_luminance(currentLight.rgb))
    {
        return;
    }

    if (illuminationMode == CONTACT_ILLUMINATION_MIN &&
        currentLight.w > 0.5 &&
        boundary_light_rgb_luminance(clampedRgb) >
            boundary_light_rgb_luminance(currentLight.rgb))
    {
        return;
    }

    fpml_profile_count_surface_vertex_write();
    LightingSurface[vertexID].light = vec4(clampedRgb, 1.0);
}

